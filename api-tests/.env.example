# Set these in your shell or PyCharm run configuration (Environment variables).
# Which environment to target: prod (default) or any name added in config/settings.py
API_ENV=prod
# Override the base URL of the chosen environment
# API_BASE_URL=https://automationexercise.com
# Seconds before a request times out
API_TIMEOUT=30
# Retries for connection errors and 5xx/429 responses
API_RETRIES=2
# Response-time limit in milliseconds checked by the smoke tests
API_MAX_MS=5000
# Set to false to skip every test that creates, updates or deletes accounts
API_ALLOW_WRITES=true
# Set to true to run the UI tests with a visible browser
UI_HEADED=false
