{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "brandsList response",
  "type": "object",
  "required": ["responseCode", "brands"],
  "additionalProperties": false,
  "properties": {
    "responseCode": {"const": 200},
    "brands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "brand"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "integer", "minimum": 1},
          "brand": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
