{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "productsList and searchProduct response",
  "type": "object",
  "required": ["responseCode", "products"],
  "additionalProperties": false,
  "properties": {
    "responseCode": {"const": 200},
    "products": {
      "type": "array",
      "items": {"$ref": "#/definitions/product"}
    }
  },
  "definitions": {
    "product": {
      "type": "object",
      "required": ["id", "name", "price", "brand", "category"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "integer", "minimum": 1},
        "name": {"type": "string", "minLength": 1},
        "price": {"type": "string", "pattern": "^Rs\\. \\d+$"},
        "brand": {"type": "string", "minLength": 1},
        "category": {
          "type": "object",
          "required": ["usertype", "category"],
          "additionalProperties": false,
          "properties": {
            "usertype": {
              "type": "object",
              "required": ["usertype"],
              "additionalProperties": false,
              "properties": {"usertype": {"enum": ["Women", "Men", "Kids"]}}
            },
            "category": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
